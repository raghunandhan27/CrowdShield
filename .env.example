# ==============================================================================
# CrowdShield Environment Configuration Template
# Copy this file to .env and adjust variables to match your environment.
# ==============================================================================

# Backend Server Configuration
CROWDSHIELD_HOST=0.0.0.0
CROWDSHIELD_PORT=8000
CROWDSHIELD_ENV=production
CROWDSHIELD_OFFLINE_MODE=true

# USB Serial Hardware Bridge (ESP32 Master Gateway)
# Windows: COM3, COM4, etc. | Linux/macOS: /dev/ttyUSB0, /dev/ttyACM0
CROWDSHIELD_SERIAL_PORT=COM3
CROWDSHIELD_BAUD_RATE=115200

# Video Ingest Configuration
# Options: 0 (local webcam), rtsp://user:pass@ip:port/h264, or http://ip:8080/video
CROWDSHIELD_CAMERA_SOURCE=0

# LoRa Radio Parameters
LORA_FREQUENCY_MHZ=433.0
LORA_BANDWIDTH_KHZ=125.0
LORA_SPREADING_FACTOR=9
LORA_TX_POWER_DBM=10
